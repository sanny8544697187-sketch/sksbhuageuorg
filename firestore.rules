rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Educational Content & Data Stores
    // Allow read for everyone (online/offline students)
    // Allow write for KrishiGyan admin operations and app sync
    match /bhu_store/{docId} {
      allow read, write: if true;
    }
    
    match /kg_mcqs/{mcqId} {
      allow read, write: if true;
    }
    
    match /kg_meta/{metaId} {
      allow read, write: if true;
    }

    match /bhu_notes/{noteId} {
      allow read, write: if true;
    }
    
    match /bhu_questions/{questionId} {
      allow read, write: if true;
    }
    
    match /bhu_customquizbank/{docId} {
      allow read, write: if true;
    }
    
    match /bhu_adminebooks/{bookId} {
      allow read, write: if true;
    }

    match /bhu_users/{userId} {
      allow read, write: if true;
    }
    
    // User Profiles & Progress Tracking
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
